{
  "name": "opencv-wasm-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run generate && vp dev --host 127.0.0.1 --port 4560 --strictPort",
    "build": "npm run generate && vp build",
    "preview": "vp preview --host 127.0.0.1 --port 4561 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.engine.json && tsc -p tsconfig.tests.json",
    "test": "vp test run",
    "lint": "vp check --no-fmt",
    "check:manifest": "node -e \"process.exit(Object.hasOwn(JSON.parse(require('node:fs').readFileSync('package.json')), 'devEngines') ? 1 : 0)\"",
    "samples": "node scripts/copy-samples.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "sync:cadence": "node scripts/sync-cadence.mjs",
    "generate": "node scripts/generate-runtime.mjs",
    "build:site": "node scripts/generate-runtime.mjs --site && vp build --mode site"
  },
  "dependencies": {
    "@banou/opencv-wasm": "0.0.6",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@noble/hashes": "2.4.0",
    "@xyflow/react": "12.11.6",
    "cadence": "file:vendor/cadence-regional",
    "mp4box": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@webgpu/types": "0.1.72",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  }
}
