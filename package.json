{
  "name": "@banou/opencv-wasm",
  "version": "0.0.6",
  "description": "OpenCV and contrib compiled to WebAssembly with generated TypeScript bindings",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banou26/opencv-wasm.git"
  },
  "homepage": "https://github.com/banou26/opencv-wasm#readme",
  "bugs": {
    "url": "https://github.com/banou26/opencv-wasm/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "files": [
    "lib",
    "src",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./opencv_js.wasm": "./lib/opencv_js.wasm",
    "./coverage.json": "./lib/coverage.json",
    "./python-parity.json": "./lib/python-parity.json",
    "./documentation.json": "./lib/documentation.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:js": "npm run docs && node scripts/prepare-loader.mjs && vite build && tsc -p tsconfig.build.json",
    "docs": "python3 scripts/extract-docs.py && node scripts/finalize-types.mjs && node scripts/namespace-types.mjs && node scripts/named-exports.mjs",
    "build": "npm run build:wasm && npm run build:js",
    "typecheck": "tsc --noEmit",
    "test:node": "node scripts/prepare-test-data.mjs && node --test tests/*.test.mjs",
    "test:browser": "node scripts/prepare-test-data.mjs && playwright test",
    "test:package": "npm pack && node scripts/test-package.mjs",
    "parity": "node scripts/python-parity.mjs",
    "test": "npm run typecheck && npm run test:node && npm run test:browser",
    "prepack": "npm run build:js && node scripts/python-parity.mjs && node scripts/verify-package.mjs",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build",
    "docs:check": "npm --prefix website run check",
    "docs:test": "npm --prefix website test",
    "editor:dev": "npm --prefix editor run dev",
    "editor:build": "npm --prefix editor run build",
    "editor:check": "npm --prefix editor run typecheck && npm --prefix editor run lint && npm --prefix editor test",
    "editor:smoke": "npm --prefix editor run smoke"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
