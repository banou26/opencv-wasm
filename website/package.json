{
  "name": "opencv-wasm-docs",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "npm run generate && astro dev --host 0.0.0.0",
    "build": "npm run generate && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "npm run generate && astro check && node scripts/check-examples.mjs",
    "test": "node scripts/check-site.mjs && playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.3",
    "marked": "^17.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "1.63.0",
    "parse5": "^8.0.1",
    "typescript": "5.9.3"
  }
}
