<script>
  class AlgorithmDiagram extends HTMLElement {
    connectedCallback() {
      const data = this.querySelector('.diagram-steps')
      if (!data) return
      const steps = JSON.parse(data.textContent!) as string[]
      for (const button of this.querySelectorAll<HTMLButtonElement>('[data-stage-button]')) button.addEventListener('click', () => {
        this.dataset.stage = button.dataset.stageButton
        for (const b of this.querySelectorAll<HTMLButtonElement>('[data-stage-button]')) b.setAttribute('aria-pressed', String(b === button))
        this.querySelector('.diagram-caption')!.textContent = `Conceptual illustration. ${steps[Number(button.dataset.stageButton)]}`
      })
    }
  }
  if (!customElements.get('algorithm-diagram')) customElements.define('algorithm-diagram', AlgorithmDiagram)
</script>
