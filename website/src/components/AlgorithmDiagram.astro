---
import type { Algorithm } from '../data/algorithms'
import { algorithmVisual } from '../lib/visuals'
const { algorithm: a, compact = false } = Astro.props as { algorithm: Algorithm; compact?: boolean }
const example = algorithmVisual(a)
const names = ['Input', 'Operation', 'Result']
---
<algorithm-diagram class:list={{ compact }} data-kind={a.diagram} data-stage="2" data-algorithm={a.id}>
  <div class="diagram-top"><span><i></i> VISUAL WALKTHROUGH</span><span>{a.category}</span></div>
  {!compact && <div class="diagram-controls" role="group" aria-label={`${a.title} explanation stages`}>
    {example.stages.map((stage, i) => <button type="button" data-stage-button={i} aria-pressed={i === 2} aria-label={`${i + 1} · ${names[i]}`}>
      <span class="step-number">0{i + 1}</span><span><b>{names[i]}</b><small>{stage.title}</small></span>
    </button>)}
  </div>}
  <div class="diagram-comparison">
    <figure class="diagram-input">
      <figcaption><span class="panel-label">REFERENCE INPUT</span><strong>{example.input.title}</strong></figcaption>
      <div class="diagram-art" role="img" aria-label={example.input.detail} set:html={example.input.svg} />
      <p class="panel-detail">{example.input.detail}</p>
    </figure>
    <div class="comparison-arrow" aria-hidden="true">→</div>
    <div class="diagram-output">
      {example.stages.map((stage, i) => (!compact || i === 2) && <figure data-stage-panel={i} hidden={i !== 2}>
        <figcaption><span class="panel-label">{i === 2 ? 'RESULT' : i === 1 ? 'WORKING VIEW' : 'FIRST STEP'}</span><strong>{stage.title}</strong></figcaption>
        <div class="diagram-art" role="img" aria-label={`${stage.title}. ${stage.detail}`} set:html={stage.svg} />
        <p class="panel-detail">{stage.detail}</p>
      </figure>)}
    </div>
  </div>
  {!compact && <div class="diagram-explanation">
    <div class="stage-heading"><span data-stage-counter>STEP 03 / 03</span><button class="diagram-play" type="button" aria-label="Play explanation steps" aria-pressed="false"><span aria-hidden="true">▷</span> Play steps</button></div>
    <p class="diagram-caption" aria-live="polite" aria-atomic="true">{a.steps[2]}</p>
    <div class="diagram-progress" aria-hidden="true"><span></span></div>
  </div>}
  <p class="diagram-note">{example.note}</p>
  {!compact && <script type="application/json" class="diagram-steps" set:html={JSON.stringify(a.steps).replaceAll('<', '\\u003c')} />}
</algorithm-diagram>
<script>
  class AlgorithmDiagram extends HTMLElement {
    private timer: ReturnType<typeof setTimeout> | undefined
    private cleanup: AbortController | undefined
    connectedCallback() {
      const data = this.querySelector('.diagram-steps')
      if (!data) return
      this.cleanup?.abort()
      this.cleanup = new AbortController()
      const options = { signal: this.cleanup.signal }
      const steps = JSON.parse(data.textContent!) as string[]
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-stage-button]')]
      const panels = [...this.querySelectorAll<HTMLElement>('[data-stage-panel]')]
      const play = this.querySelector<HTMLButtonElement>('.diagram-play')!
      const caption = this.querySelector<HTMLElement>('.diagram-caption')!
      const select = (index: number) => {
        this.dataset.stage = String(index)
        buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)))
        panels.forEach((panel, i) => panel.hidden = i !== index)
        caption.textContent = steps[index]
        this.querySelector('[data-stage-counter]')!.textContent = `STEP 0${index + 1} / 03`
      }
      const stop = () => {
        clearTimeout(this.timer)
        this.timer = undefined
        this.dataset.playing = 'false'
        play.setAttribute('aria-pressed', 'false')
        play.setAttribute('aria-label', 'Play explanation steps')
        play.innerHTML = '<span aria-hidden="true">▷</span> Play steps'
        caption.setAttribute('aria-live', 'polite')
      }
      buttons.forEach((button, index) => {
        button.addEventListener('click', () => { stop(); select(index) }, options)
        button.addEventListener('keydown', event => {
          const next = event.key === 'ArrowRight' ? (index + 1) % 3 : event.key === 'ArrowLeft' ? (index + 2) % 3 : event.key === 'Home' ? 0 : event.key === 'End' ? 2 : -1
          if (next < 0) return
          event.preventDefault(); stop(); select(next); buttons[next].focus()
        }, options)
      })
      play.addEventListener('click', () => {
        if (this.timer !== undefined) { stop(); return }
        caption.setAttribute('aria-live', 'off')
        select(0)
        this.dataset.playing = 'true'
        play.setAttribute('aria-pressed', 'true')
        play.setAttribute('aria-label', 'Pause explanation steps')
        play.innerHTML = '<span aria-hidden="true">Ⅱ</span> Pause'
        const advance = () => {
          const stage = Number(this.dataset.stage)
          if (stage >= 2) { stop(); return }
          select(stage + 1)
          this.timer = setTimeout(advance, 3200)
        }
        this.timer = setTimeout(advance, 3200)
      }, options)
      document.addEventListener('visibilitychange', () => { if (document.hidden) stop() }, options)
    }
    disconnectedCallback() { clearTimeout(this.timer); this.timer = undefined; this.cleanup?.abort() }
  }
  if (!customElements.get('algorithm-diagram')) customElements.define('algorithm-diagram', AlgorithmDiagram)
</script>
<style>
  algorithm-diagram{display:block;container-type:inline-size;margin:1.6rem 0;border:1px solid #303c50;border-radius:14px;background:#101722;color:#e4e8f0;overflow:hidden;--sl-color-text:#e4e8f0}
  .diagram-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.2rem;color:#a1aec3;font:400 .61rem var(--sl-font-mono);letter-spacing:.085em;border-bottom:1px solid #263244;background:#151e2c}
  .diagram-top span{display:flex;align-items:center;gap:.5rem;margin:0}.diagram-top span:last-child{color:#b5a0ff;letter-spacing:0}
  .diagram-top i{width:6px;height:6px;border-radius:50%;background:#63e2bd}
  .diagram-controls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;margin:0!important;padding:1rem 1rem .25rem}
  .diagram-controls button{display:flex;align-items:flex-start;gap:.6rem;text-align:left;border:1px solid #303c50;border-radius:8px;background:#172030;color:#a7b3c8;padding:.7rem .6rem;cursor:pointer;min-width:0;font:400 .8rem var(--sl-font)}
  .diagram-controls button[aria-pressed=true]{border-color:#a993f1;background:#b5a0ff16;color:#e2d9ff;box-shadow:inset 0 2px #b5a0ff}
  .step-number{font:400 .72rem var(--sl-font-mono);opacity:.8;line-height:1.5}.diagram-controls b{display:block;font-weight:550;line-height:1.4}.diagram-controls small{display:block;font-size:.67rem;line-height:1.4;margin-top:.3rem;color:#a7b3c8}
  .diagram-comparison{display:grid;grid-template-columns:minmax(0,1fr) 24px minmax(0,1fr);align-items:start;gap:0;padding:1rem;margin:0!important}
  figure,.diagram-output{margin:0!important;min-width:0}figcaption{display:flex;flex-direction:column;gap:.35rem;min-height:3.8rem;padding:0 .3rem .6rem;font-size:.81rem;line-height:1.4}figcaption strong{font-weight:550;color:#e4e8f0}.panel-label{color:#a1aec3;font:400 .58rem var(--sl-font-mono);letter-spacing:.08em}.diagram-output .panel-label{color:#63e2bd}
  .diagram-art{border:1px solid #2a364a;border-radius:7px;overflow:hidden;background:#131c2b;margin:0!important}.diagram-art :global(svg){display:block;width:100%;height:auto;margin:0!important}.diagram-art :global(text){font-family:var(--sl-font-mono)}
  .comparison-arrow{align-self:start;margin-top:7rem;color:#63e2bd;text-align:center;font-size:1.1rem}
  .panel-detail{color:#b0bbcf;font-size:.74rem!important;line-height:1.65;margin:.75rem .3rem 0!important}
  .diagram-explanation{position:relative;padding:1rem 1.2rem 1.1rem;background:#192438;border-block:1px solid #303c50;margin:0!important}
  .stage-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:0!important}.stage-heading>span{font:400 .61rem var(--sl-font-mono);letter-spacing:.08em;color:#b5a0ff}
  .diagram-play{background:transparent;border:1px solid #516078;color:#d1dbea;border-radius:5px;padding:.3rem .65rem;font:400 .7rem var(--sl-font);cursor:pointer;margin:0!important;white-space:nowrap}.diagram-play span{color:#63e2bd;margin-right:.2rem}
  button:focus-visible{outline:2px solid #63e2bd;outline-offset:3px}.diagram-caption{font-size:.82rem!important;line-height:1.65;margin:.65rem 0 0!important;min-height:2.7em;color:#d1dbea}
  .diagram-note{font-size:.66rem!important;color:#a0acc0;padding:.8rem 1.2rem;line-height:1.6;margin:0!important;background:#101722}
  .diagram-progress{position:absolute;bottom:0;left:0;right:0;height:2px;background:#263244;margin:0!important}.diagram-progress span{display:block;height:100%;background:#b5a0ff;width:100%;transition:width .18s ease}
  [data-stage="0"] .diagram-progress span{width:33.333%}[data-stage="1"] .diagram-progress span{width:66.666%}[hidden]{display:none!important}
  .compact .diagram-comparison{padding:.8rem}.compact .diagram-top{padding:.75rem 1rem}.compact .panel-detail{font-size:.7rem!important}
  @container(max-width:470px){.diagram-controls{gap:.3rem;padding:.7rem .7rem .2rem}.diagram-controls button{padding:.65rem .4rem;gap:.3rem;align-items:center;justify-content:center}.diagram-controls small{display:none}.diagram-controls b{font-size:.75rem}.step-number{font-size:.6rem}.diagram-comparison{grid-template-columns:1fr;gap:.75rem;padding:.8rem}figcaption{min-height:0;padding-bottom:.5rem}.comparison-arrow{margin:0;line-height:1;transform:rotate(90deg)}.panel-detail{font-size:.76rem!important}.diagram-top{font-size:.53rem;padding:.85rem}.diagram-caption{min-height:0}.diagram-input .diagram-art{max-width:100%}}
  @media(prefers-reduced-motion:reduce){.diagram-progress span{transition:none}}
</style>
